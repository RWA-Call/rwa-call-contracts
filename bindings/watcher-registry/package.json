{
  "name": "@rwa-call/watcher-registry",
  "version": "0.1.0",
  "description": "TypeScript bindings for the RWA Call WatcherRegistry Soroban contract",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
