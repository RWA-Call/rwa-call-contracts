    "directory": "bindings/watcher-registry"
  },
  "homepage": "https://github.com/RWA-Call/rwa-call-contracts#readme",
  "bugs": {
    "url": "https://github.com/RWA-Call/rwa-call-contracts/issues"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=12.0.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "12.3.0",
    "typescript": "5.4.5"
  }
